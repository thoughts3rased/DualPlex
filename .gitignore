# Host-only unit test build output (see tests/README.md) - platform-specific,
# trivially regenerated by `make -f tests/Makefile`, not part of the shipped app.
tests/build/

# 3DS build output - regenerated by `make`, and rebuilt/published fresh by
# .github/workflows/build-release.yml on every push to main, so checked-in
# copies just go stale and bloat diffs.
build/
DualPlex.elf
DualPlex.3dsx
DualPlex.cia
DualPlex.smdh
